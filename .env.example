# ============================================
#  API 키 파일
# ============================================
#
#  1. 이 파일을 복사해서 이름을 ".env" 로 바꾸세요.
#  2. 아래 = 뒤에 발급받은 키를 붙여넣으세요.
#  3. 따옴표 없이, 띄어쓰기 없이 붙여넣습니다.
#
#  ".env" 파일은 git 에 올라가지 않습니다.
# ============================================


# --- 네이버 검색광고 API — 월간검색수 조회 -----
# https://searchad.naver.com  로그인 > 도구 > API 사용 관리
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=
NAVER_AD_CUSTOMER_ID=


# --- 네이버 개발자센터 앱 (무료) ----------------
# 블로그 문서수(경쟁도) 조회용
# https://developers.naver.com/apps  > 애플리케이션 등록 > 검색 API 선택
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=


# --- 유튜브 (무료) -----------------------------
# console.cloud.google.com > API 및 서비스 > 사용자 인증 정보
YOUTUBE_API_KEY=


# --- 에피파이 / 인스타그램 (월 $5 무료 크레딧) ----
# apify.com > Settings > API & Integrations > Personal API token
APIFY_TOKEN=


# --- 스레드(Threads) 자동화 ---------------------
# Meta 개발자 콘솔에서 받은 장기 액세스 토큰 (60일, 자동 갱신됨)
# https://developers.facebook.com/apps  > Threads API
# 스코프: threads_basic, threads_content_publish, threads_read_replies, threads_manage_replies
THREADS_ACCESS_TOKEN=

# 글 작성과 댓글 판단에 쓴다
# https://console.anthropic.com  > API Keys
ANTHROPIC_API_KEY=

# 선택 — 비워두면 기본값으로 돈다. 자세한 건 docs/THREADS.md
# THREADS_PAUSED=1                 전부 멈춤
# THREADS_MAX_POSTS_PER_DAY=4      하루 최대 발행 수
# THREADS_MAX_REPLIES_PER_RUN=10   한 번에 다는 최대 답글 수
# THREADS_REPLY_MAX_AGE_HOURS=72   이보다 오래된 댓글은 답하지 않는다
# THREADS_MODEL=claude-sonnet-5    글 쓰는 모델

