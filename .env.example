# ============================================
#  API 키 파일
# ============================================
#
#  1. 이 파일을 복사해서 이름을 ".env" 로 바꾸세요.
#  2. 아래 = 뒤에 발급받은 키를 붙여넣으세요.
#  3. 따옴표 없이, 띄어쓰기 없이 붙여넣습니다.
#
#  예)  NAVER_CLIENT_ID=abcd1234efgh
#
#  ".env" 파일은 git에 올라가지 않습니다. 안심하세요.
# ============================================


# --- 네이버 (무료) -----------------------------
# developers.naver.com > Application > 애플리케이션 등록
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=


# --- 유튜브 (무료) -----------------------------
# console.cloud.google.com > API 및 서비스 > 사용자 인증 정보
YOUTUBE_API_KEY=


# --- 에피파이 / 인스타그램 (월 $5 무료 크레딧) ----
# apify.com > Settings > API & Integrations > Personal API token
APIFY_TOKEN=
