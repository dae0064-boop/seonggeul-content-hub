  "blocks": [
    {
      "type": "p",
      "lines": [
        {
          "t": "대장암 초기증상은 아무것도 느껴지지 않는"
        },
        {
          "t": "경우가 많다고 해요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "오늘은 변이 가늘어졌을 때"
        },
        {
          "t": "대장암 증상인지 걱정되는 마음을 같이 짚어 볼게요."
        },
        {
          "t": "답은 하나의 증상보다 함께 오는 신호에 있어요."
        }
      ]
    },
    {
      "type": "image",
      "n": 1,
      "lines": [
        {
          "t": "거실에서 마주 앉아 건강 이야기를 나누며 생각에 잠긴 30대 아들과 60대 아버지 (대표사진)"
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "대장암 증상, 변이 가늘어지면"
        }
      ]
    },
    {
      "type": "image",
      "n": 2,
      "lines": [
        {
          "t": "아침 욕실 앞에서 머리를 긁적이며 잠시 생각하는 40대 남성"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "어느 날 변 굵기가 눈에 띄게 가늘어지면"
        },
        {
          "t": "혹시 하는 마음에 검색부터 하게 되죠."
        },
        {
          "t": "그 걱정, 충분히 그럴 만해요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "괜찮아요, 하나씩 보면 돼요."
        },
        {
          "t": "변 굵기는 먹은 음식, 물, 변비 같은"
        },
        {
          "t": "여러 이유로 달라질 수 있어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "그러니 한 번 가늘었다고 대장암 증상이라고"
        },
        {
          "t": "단정하지 않아도 돼요."
        },
        {
          "t": "대신 며칠, 몇 주 이어지는지는 봐 두세요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "다만 국가건강정보포털은 이렇게 설명해요."
        },
        {
          "t": "최근 들어 변 굵기가 가늘어진 경우는",
          "s": "yellow"
        },
        {
          "t": "원인을 꼭 살펴볼 신호로 꼽혀요.",
          "s": "yellow"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "특히 다른 신호가 함께 있을 때예요."
        },
        {
          "t": "그래서 오늘은 변 하나만 보지 않고"
        },
        {
          "t": "같이 봐야 할 것들을 정리해 볼게요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "며칠 동안 언제 무엇을 먹었는지,"
        },
        {
          "t": "물은 얼마나 마셨고 언제 변을 봤는지"
        },
        {
          "t": "적어 두면 진료받을 때 도움이 된대요."
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "초기에는 왜 모르고 지나갈까"
        }
      ]
    },
    {
      "type": "image",
      "n": 3,
      "lines": [
        {
          "t": "진료실에서 의사의 설명을 차분히 듣는 50대 여성"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "대장암 초기에는 대부분 아무 느낌이 없어요."
        },
        {
          "t": "그래서 증상이 없다고 안심하기도,"
        },
        {
          "t": "증상 하나로 겁먹기도 이른 거예요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "진행되면서 생길 수 있는 대장암 증상은"
        },
        {
          "t": "배가 아프거나 배변 습관이 바뀌는 거예요."
        },
        {
          "t": "설사나 변비가 새로 생기기도 해요.",
          "segs": [
            {
              "t": "설사",
              "s": "blue"
            },
            {
              "t": "나 "
            },
            {
              "t": "변비",
              "s": "blue"
            },
            {
              "t": "가 새로 생기기도 해요."
            }
          ]
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "배에서 평소 없던 혹이 만져지거나"
        },
        {
          "t": "빈혈이 생길 수도 있대요.",
          "segs": [
            {
              "t": "빈혈",
              "s": "blue"
            },
            {
              "t": "이 생길 수도 있대요."
