        {
          "t": "섞였는지 보는 검사예요."
        },
        {
          "t": "매년 받는 게 권장돼요.",
          "segs": [
            {
              "t": "매년",
              "s": "blue"
            },
            {
              "t": " 받는 게 권장돼요."
