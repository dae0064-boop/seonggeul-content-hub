  "blocks": [
    {
      "type": "p",
      "lines": [
        {
          "t": "이미숙의 주식 이야기는 유튜브 영상"
        },
        {
          "t": "미숙한 자매전쟁 시즌2 촬영 중에 나왔어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "오늘은 배우 이미숙 주식 고백을 정리해 볼게요."
        },
        {
          "t": "\"집 날아갔다\"는 말이 정말 무슨 뜻이었는지,"
        },
        {
          "t": "왜 이렇게 화제가 됐는지 차례로 볼게요."
        }
      ]
    },
    {
      "type": "image",
      "n": 1,
      "lines": [
        {
          "t": "창가 책상 위에 놓인 노트북과 식은 커피 한 잔 (대표사진)"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "[사진 출처 1]"
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "이미숙 주식 고백, 어디서 나왔을까"
        }
      ]
    },
    {
      "type": "image",
      "n": 2,
      "lines": [
        {
          "t": "주방에서 요리 촬영을 준비하는 조용한 세트"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "예를 들어 저녁에 요리 영상을 틀어 놨다가"
        },
        {
          "t": "갑자기 주식 이야기가 튀어나와"
        },
        {
          "t": "\"어? 이미숙도 주식을 해?\" 하고"
        },
        {
          "t": "화면을 다시 본 분이 많았을 거예요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "영상은 10월 30일 유튜브 채널",
          "segs": [
            {
              "t": "영상은 "
            },
            {
              "t": "10월 30일",
              "s": "blue"
            },
            {
              "t": " 유튜브 채널"
            }
          ]
        },
        {
          "t": "숙스러운 미숙씨에 올라왔어요.",
          "segs": [
            {
              "t": "숙스러운 미숙씨",
              "s": "blue"
            },
            {
              "t": "에 올라왔어요."
            }
          ]
        },
        {
          "t": "미숙한 자매전쟁 시즌2 영상으로,",
          "segs": [
            {
              "t": "미숙한 자매전쟁 "
            },
            {
              "t": "시즌2",
              "s": "blue"
            },
            {
              "t": " 영상으로,"
            }
          ]
        },
        {
          "t": "제육과 순두부를 두고 고민하는 요리 편이었어요.",
          "segs": [
            {
              "t": "제육",
              "s": "blue"
            },
            {
              "t": "과 "
            },
            {
              "t": "순두부",
              "s": "blue"
            },
            {
              "t": "를 두고 고민하는 요리 편이었어요."
            }
          ]
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "그런데 촬영 도중 이미숙이 제작진에게"
        },
        {
          "t": "주식 때문에 마음이 편치 않다고 털어놨어요."
        },
        {
          "t": "이미숙 주식 이야기는 그렇게 시작됐어요.",
          "s": "yellow"
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "집 날아갔다는 말, 진짜일까"
        }
      ]
    },
    {
      "type": "image",
      "n": 3,
      "lines": [
        {
          "t": "영상에서 나온 말과 알려진 사실을 정리한 카드"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "가장 크게 퍼진 말은 \"집 날아갔다\"예요."
        },
        {
          "t": "이미숙은 사 주려던 집이 날아갔다며"
        },
        {
          "t": "반쯤 웃으며 말했다고 전해졌어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "실제로 집을 잃었다는 뜻은 아니에요.",
          "s": "red"
        },
        {
          "t": "농담처럼 던진 말이라"
        },
        {
          "t": "그만큼 손해가 컸다는 뜻으로 읽혀요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "투자한 종목도, 주식 손실이 얼마인지도"
        },
        {
          "t": "영상에서는 밝히지 않았어요."
        },
        {
          "t": "그래서 금액을 짐작하는 말은 모두 추측이에요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "\"얼마나 잃었길래 집 얘기까지 나와?\" 하고"
        },
        {
          "t": "궁금해하는 분이 많지만"
        },
        {
          "t": "지금까지 알려진 건 여기까지예요."
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "늘그막에 왜 시작했을까"
        }
      ]
    },
    {
      "type": "image",
      "n": 4,
      "lines": [
        {
          "t": "친구들이 둘러앉은 카페 탁자 위 찻잔들"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "이미숙은 66세에 처음 주식을 시작했어요.",
          "segs": [
            {
              "t": "이미숙은 "
            },
            {
              "t": "66세",
              "s": "blue"
            },
            {
              "t": "에 처음 주식을 시작했어요."
            }
          ]
        },
        {
          "t": "\"생전 주식도 안 하다가 왜 늘그막에\"라며"
        },
        {
          "t": "스스로 웃픈 후회를 하기도 했어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "시작한 까닭은 주변 분위기였어요."
        },
        {
          "t": "다들 주식 이야기를 하니"
        },
        {
          "t": "안 하면 뒤처지는 기분이 들었다는 거예요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "\"주식 안 하면 범죄자 같다\"는 말까지 했어요."
        },
        {
          "t": "귀가 얇은 데다 남이 돈 버는 걸"
        },
        {
          "t": "그냥 보고 있기 어려웠다고 웃으며 털어놨어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "이런 마음을 흔히 포모라고 불러요."
        },
        {
          "t": "남들은 다 버는데 나만 놓치는 것 같은"
        },
        {
          "t": "불안한 기분을 뜻하는 말이에요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "포모는 누구에게나 찾아올 수 있는 마음이에요.",
          "s": "yellow"
        },
        {
          "t": "주변 사람들이 수익 이야기를 할 때"
        },
        {
          "t": "포모는 더 크게 느껴지기 쉬워요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "그래서 이미숙 주식 고백에 고개를 끄덕인"
        },
        {
          "t": "분들이 많았던 것 같아요."
        },
        {
          "t": "나만 그런 게 아니었구나 하고요."
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "숙스러운 미숙씨는 어떤 채널일까"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "숙스러운 미숙씨는 이미숙이 직접 나오는"
        },
        {
          "t": "유튜브 채널이에요."
        },
        {
          "t": "이름 그대로 꾸밈없는 모습을 보여 줘요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "요리하고 수다 떨다가 나온 한마디라"
        },
        {
          "t": "더 솔직하게 들렸던 것 같아요."
        },
        {
          "t": "이번 영상도 그런 편안한 분위기에서 나왔어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "화려한 배우의 모습보다"
        },
        {
          "t": "옆집 언니 같은 얼굴을 보여 주는 채널이라"
        },
        {
          "t": "주식 이야기도 더 가깝게 느껴졌을 거예요."
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "포모에 흔들릴 때 해 볼 것"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "이미숙 주식 이야기를 보며"
        },
        {
          "t": "\"나도 남 얘기가 아니네\" 싶은 분도 있을 거예요."
        },
        {
          "t": "이럴 때 해 볼 만한 건 어렵지 않아요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "먼저 생활비와 비상금을 따로 떼어 두고"
        },
        {
          "t": "남는 돈 안에서만 해 보는 거예요."
        },
        {
          "t": "잃어도 생활이 흔들리지 않는 만큼만요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "그리고 남의 수익 이야기를 들은 날에는"
        },
        {
          "t": "바로 사지 말고 하루쯤 미뤄 보세요."
        },
        {
          "t": "급한 마음이 가라앉으면 판단이 달라지기도 해요."
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "이미숙 주식 Q&A"
        }
      ]
    },
    {
      "type": "image",
      "n": 5,
      "lines": [
        {
          "t": "영상에서 밝힌 것과 밝히지 않은 것을 나눈 카드"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "이미숙 주식 이야기에 많이 묻는 두 가지예요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "Q1: 이미숙 주식 손실은 얼마인가요?"
        },
        {
          "t": "A1: 영상에서 금액은 밝히지 않았어요."
        },
        {
          "t": "어떤 종목인지도 말하지 않았어요."
        },
        {
          "t": "집 이야기는 농담으로 전해졌어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "Q2: 어디서 영상을 볼 수 있나요?"
        },
        {
          "t": "A2: 유튜브 채널 숙스러운 미숙씨에"
        },
        {
          "t": "10월 30일 올라온 자매전쟁 편이에요."
        },
        {
          "t": "요리 이야기 사이에 주식 이야기가 나와요."
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "이미숙 주식, 정리하면"
        }
      ]
    },
    {
      "type": "image",
      "n": 6,
      "lines": [
        {
          "t": "저녁 햇살이 드는 창가에 놓인 화분과 노트"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "여러분은 주식 해 보셨어요, 아직이세요?"
        },
        {
          "t": "\"해 봤다\", \"아직\" 한마디로 남겨 주세요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "이미숙 주식 고백은 큰 손실 고백이라기보다",
          "s": "red"
        },
        {
          "t": "솔직한 후회에 가까웠어요.",
          "s": "red"
        },
        {
          "t": "남들 따라 서두르기보다",
          "s": "yellow"
        },
        {
          "t": "내 형편에 맞는 속도가 먼저예요.",
          "s": "yellow"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "배우도 우리처럼 남들 따라 흔들린다는 걸"
        },
        {
          "t": "솔직하게 보여 준 영상이었어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "주식 손실은 누구에게나 생길 수 있으니",
          "s": "red"
        },
        {
          "t": "여윳돈 안에서만 해 보세요.",
          "s": "red"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "오늘 내용은 텐아시아·한국경제 등 언론 보도에서"
        },
        {
          "t": "확인한 정보를 바탕으로 정리했어요."
        },
        {
          "t": "(2026년 11월 기준이라 이후 달라질 수 있어요)"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "좋아요·공감과 이웃추가 부탁드려요💙"
        },
        {
          "t": "이상 성글벙글의 연예 이슈 포스팅이었습니다😎"
        }
      ]
    }
  ]
}
