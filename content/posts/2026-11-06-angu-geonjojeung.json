  "blocks": [
    {
      "type": "p",
      "lines": [
        {
          "t": "눈 뻑뻑함은 눈물이 모자랄 때만이 아니라"
        },
        {
          "t": "눈물이 너무 빨리 마를 때도 생겨요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "오늘은 난방을 켜는 요즘"
        },
        {
          "t": "안구건조증이 왜 더 신경 쓰이는지 알아볼게요."
        },
        {
          "t": "괜찮아요, 집에서 바꿀 수 있는 것부터 보면 돼요."
        }
      ]
    },
    {
      "type": "image",
      "n": 1,
      "lines": [
        {
          "t": "거실 소파에서 눈을 깜빡이다 눈썹을 올리며 놀란 표정의 60대 여성 얼굴 (대표사진)"
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "안구건조증, 요즘 더 심해지는 이유"
        }
      ]
    },
    {
      "type": "image",
      "n": 2,
      "lines": [
        {
          "t": "난방이 켜진 저녁 거실에서 텔레비전을 보다 눈가를 손등으로 문지르는 70대 남성"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "아침에 눈 뜨기가 힘들고"
        },
        {
          "t": "모래가 들어간 것처럼 까끌거리면"
        },
        {
          "t": "괜히 걱정부터 되시죠."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "국가건강정보포털을 보면"
        },
        {
          "t": "안구건조증은 아주 흔한 눈 질환이에요."
        },
        {
          "t": "진료받는 사람이 해마다 약 250만 명이래요.",
          "segs": [
            {
              "t": "진료받는 사람이 해마다 "
            },
            {
              "t": "약 250만 명",
              "s": "blue"
            },
            {
              "t": "이래요."
            }
          ]
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "난방기를 세게 틀면 눈물이 더 빨리 말라요.",
          "s": "yellow"
        },
        {
          "t": "포털은 히터·온풍기를 너무 세게 쓰거나,"
        },
        {
          "t": "겨울철 닫힌 집에서 환기를 덜 하는 걸"
        },
        {
          "t": "악화 요인으로 꼽아요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "나이도 함께 봐야 해요."
        },
        {
          "t": "40세가 넘으면 흔해지고,",
          "segs": [
            {
              "t": "40세",
              "s": "blue"
            },
            {
              "t": "가 넘으면 흔해지고,"
            }
          ]
        },
        {
          "t": "나이가 들수록 눈물샘 기능이 떨어진대요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "증상도 사람마다 달라요."
        },
        {
          "t": "뻑뻑함, 이물감, 따가움, 충혈,"
        },
        {
          "t": "눈이 쉽게 피로하고 흐려 보이는 것까지요."
        },
        {
          "t": "눈을 감고 있으면 편해지는 게 공통점이래요."
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "눈물이 모자랄까, 빨리 마를까"
        }
      ]
    },
    {
      "type": "image",
      "n": 3,
      "lines": [
        {
          "t": "안구건조증의 두 가지 유형을 비교한 카드"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "안구건조증은 크게 두 갈래예요."
        },
        {
          "t": "눈물이 적게 만들어지거나,"
        },
        {
          "t": "만들어진 눈물이 너무 빨리 증발하거나요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "눈물막은 기름층·수성층·점액층 세 겹이에요.",
          "segs": [
            {
              "t": "눈물막은 "
            },
            {
              "t": "기름층",
              "s": "blue"
            },
            {
              "t": "·"
            },
            {
              "t": "수성층",
              "s": "blue"
            },
            {
              "t": "·점액층 세 겹이에요."
            }
          ]
        },
        {
          "t": "그중 물 성분인 수성층이 약 80%예요."
        },
        {
          "t": "기름층이 얇아지면 물이 쉽게 날아가요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "그래서 건성안이라고도 불러요."
