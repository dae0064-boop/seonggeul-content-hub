      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "따뜻한 찜질도 같은 자리에서 나와요."
        },
        {
          "t": "눈꺼풀 속 마이봄샘의 기름이 잘 나오게 돕는대요.",
          "segs": [
            {
              "t": "눈꺼풀 속 "
            },
            {
              "t": "마이봄샘",
              "s": "blue"
            },
            {
              "t": "의 기름이 잘 나오게 돕는대요."
            }
          ]
        },
        {
          "t": "기름층이 살아야 눈물이 덜 날아가거든요."
        }
