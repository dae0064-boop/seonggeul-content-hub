          "t": "[사진 출처 2]"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "닥터X 몇부작인지부터 보면 12부작이에요.",
          "segs": [
            {
              "t": "닥터X 몇부작인지부터 보면 "
