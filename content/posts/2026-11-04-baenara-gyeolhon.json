    },
    {
      "type": "p",
      "lines": [
        {
          "t": "배나라는 1월에 처음 나와",
          "segs": [
            {
              "t": "배나라는 "
            },
            {
              "t": "1월",
              "s": "blue"
            },
            {
              "t": "에 처음 나와"
            }
          ]
        },
        {
          "t": "약 10개월 만에 프로그램을 졸업하게 됐어요.",
          "segs": [
            {
              "t": "약 "
            },
            {
              "t": "10개월",
              "s": "blue"
            },
            {
              "t": " 만에 프로그램을 졸업하게 됐어요."
