  "blocks": [
    {
      "type": "p",
      "lines": [
        {
          "t": "뮤지컬 커플 두 사람은 2019년"
        },
        {
          "t": "뮤지컬 '그리스' 무대에서 처음 만났어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "어제 오후 연예 소식 1위는 배나라 결혼이었어요."
        },
        {
          "t": "출근길에 \"나 혼자 산다 하차래\" 하는 말을 듣고"
        },
        {
          "t": "깜짝 놀란 분도 많았을 거예요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "예를 들어 금요일 밤마다 나 혼자 산다를"
        },
        {
          "t": "챙겨 보던 분이라면 반가우면서도"
        },
        {
          "t": "조금 서운한 마음이 들기 쉬워요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "오늘은 배나라 결혼 소식과 하차 이유를"
        },
        {
          "t": "보도된 사실대로 차근차근 정리해 볼게요."
        },
        {
          "t": "결혼식 날짜와 두 사람의 인연까지 함께 볼게요."
        }
      ]
    },
    {
      "type": "image",
      "n": 1,
      "lines": [
        {
          "t": "배나라 사진 (대표사진)"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "[사진 출처 1]"
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "배나라 결혼, 언제 어디서 하나"
        }
      ]
    },
    {
      "type": "image",
      "n": 2,
      "lines": [
        {
          "t": "성당 앞 계단과 하얀 꽃 장식"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "배나라와 한재아는 11월 14일 오후",
          "segs": [
            {
              "t": "배나라와 한재아는 "
            },
            {
              "t": "11월 14일",
              "s": "blue"
            },
            {
              "t": " 오후"
            }
          ]
        },
        {
          "t": "서울 성동구 옥수동 성당에서 결혼식을 올려요."
        },
        {
          "t": "두 사람 소속사가 11월 3일 함께 알렸어요.",
          "segs": [
            {
              "t": "두 사람 소속사가 "
            },
            {
              "t": "11월 3일",
              "s": "blue"
            },
            {
              "t": " 함께 알렸어요."
            }
          ]
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "예식은 양가 가족과 가까운 지인만 모시는",
          "s": "yellow"
        },
        {
          "t": "비공개로 진행될 예정이에요.",
          "s": "yellow"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "옥수동 성당 결혼식까지 열흘 남짓이라"
        },
        {
          "t": "소식이 나오자마자 축하가 이어졌어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "결혼 소식은 열애를 밝힌 지 약 10개월 만이에요."
        },
        {
          "t": "결혼 날짜와 장소는 모두 소속사가",
          "s": "red"
        },
        {
          "t": "직접 밝힌 내용이에요.",
          "s": "red"
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "배나라 결혼, 직접 쓴 편지"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "배나라는 같은 날 SNS에 자필 편지를 올려"
        },
        {
          "t": "결혼 소식을 직접 전했어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "\"평생을 함께 걸어가고 싶은"
        },
        {
          "t": "소중한 사람이 생겼다\"고 적었어요."
        },
        {
          "t": "배우이자 한 가정의 가장으로"
        },
        {
          "t": "성실히 살겠다는 말도 남겼어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "기쁠 때는 웃음을 먼저 나누고"
        },
        {
          "t": "힘들 때는 서로 버팀목이 되겠다는 약속도 적었어요."
        },
        {
          "t": "손 글씨로 직접 전했다는 점에",
          "s": "yellow"
        },
        {
          "t": "팬들의 축하가 더 많이 모였어요.",
          "s": "yellow"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "한재아도 SNS에 자필 편지를 올렸어요."
        },
        {
          "t": "앞으로도 배우로서 같은 마음으로"
        },
        {
          "t": "일하겠다는 뜻을 전했어요."
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "나 혼자 산다 하차, 왜일까"
