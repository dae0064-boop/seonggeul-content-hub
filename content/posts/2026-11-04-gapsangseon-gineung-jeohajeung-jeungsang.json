  "blocks": [
    {
      "type": "p",
      "lines": [
        {
          "t": "갑상선기능저하증은 일차성이 95% 넘고,"
        },
        {
          "t": "그중 상당수가 하시모토 갑상선염 때문이에요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "오늘은 갑상선기능저하증증상이 왜"
        },
        {
          "t": "그냥 피곤한 것과 헷갈리는지 알아볼게요."
        },
        {
          "t": "답은 증상이 아주 천천히 온다는 데 있어요."
        }
      ]
    },
    {
      "type": "image",
      "n": 1,
      "lines": [
        {
          "t": "거실 창가에서 고개를 살짝 기울이고 무언가 궁금한 표정을 짓는 50대 여성의 얼굴 (대표사진)"
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "갑상선기능저하증증상, 왜 놓치기 쉬울까"
        }
      ]
    },
    {
      "type": "image",
      "n": 2,
      "lines": [
        {
          "t": "저녁 식탁에서 두꺼운 카디건을 여미고 따뜻한 차를 마시는 50대 여성"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "갑상선기능저하증증상은 아주 평범한 얼굴로 와요."
        },
        {
          "t": "요즘 유난히 피곤하고 추위를 탄다면"
        },
        {
          "t": "나이 탓, 날씨 탓부터 하게 되죠."
        },
        {
          "t": "그런데 몸 안의 호르몬 때문일 수도 있어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "갑상선호르몬은 몸의 대사 속도를 맞춰요."
        },
        {
          "t": "이 호르몬이 모자라면 몸 전체가"
        },
        {
          "t": "천천히 돌아가는 상태가 돼요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "에너지가 덜 만들어지니 쉽게 지치고,"
        },
        {
          "t": "심하면 한여름에도 내복을 찾을 만큼"
        },
        {
          "t": "추위를 타기도 해요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "증상이 서서히 와서 본인도 잘 모르는 경우가 많아요.",
          "s": "red"
        },
        {
          "t": "그래서 갑상선기능저하증증상은"
        },
        {
          "t": "다른 병과 구별하기가 쉽지 않아요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "원인으로 흔한 건 하시모토 갑상선염이에요."
        },
        {
          "t": "몸의 면역이 갑상선을 공격해"
        },
        {
          "t": "갑상선세포가 아주 천천히 줄어드는 거예요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "출산 뒤나 바이러스 감염 뒤에"
        },
        {
          "t": "잠깐 저하증이 왔다가"
        },
        {
          "t": "저절로 돌아오는 경우도 있어요."
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "갑상선저하증, 이런 신호가 겹쳐요"
        }
      ]
    },
    {
      "type": "image",
      "n": 3,
      "lines": [
        {
          "t": "갑상선저하증에서 흔한 신호를 정리한 카드"
