      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "받은 돈은 전액 돌려줘야 해요."
        },
        {
          "t": "대신 실업급여와 모성보호급여는"
        },
        {
          "t": "최대 5배의 추가징수가 면제돼요.",
          "segs": [
            {
              "t": "최대 "
            },
            {
              "t": "5배",
              "s": "blue"
            },
            {
              "t": "의 추가징수가 면제돼요."
