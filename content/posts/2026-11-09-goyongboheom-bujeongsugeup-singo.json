      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "집중신고기간은 오늘 11월 9일에 시작해",
          "segs": [
            {
              "t": "집중신고기간은 오늘 "
            },
            {
              "t": "11월 9일",
              "s": "blue"
            },
            {
              "t": "에 시작해"
