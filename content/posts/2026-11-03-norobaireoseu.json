  "topic": "건강·의학",
  "blocks": [
    {
      "type": "p",
      "lines": [
        {
          "t": "겨울 식중독으로 꼽히는 노로바이러스는"
        },
        {
          "t": "11월부터 이듬해 4월까지 주로 생겨요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "오늘은 노로바이러스가 왜 가족끼리"
        },
        {
          "t": "그렇게 잘 옮는지 알아볼게요."
        },
        {
          "t": "답은 손과 구토물, 그리고 집 안 물건에 있어요."
        }
      ]
    },
    {
      "type": "image",
      "n": 1,
      "lines": [
        {
          "t": "손 씻는 법을 듣고 눈썹을 올리며 놀란 표정을 짓는 40대 아빠의 얼굴 (대표사진)"
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "노로바이러스, 왜 이렇게 잘 옮을까"
        }
      ]
    },
    {
      "type": "image",
      "n": 2,
      "lines": [
        {
          "t": "아이를 안고 거실 소파에 앉아 이마를 살며시 짚어 보는 30대 엄마"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "아이가 토하고 나면 다음 날 엄마가,"
        },
        {
          "t": "그다음 날 아빠가 눕는 집이 많아요."
        },
        {
          "t": "내가 뭘 잘못했나 싶어 마음이 무거워지죠."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "괜찮아요, 그만큼 노로바이러스는"
        },
        {
          "t": "전염력이 매우 강한 바이러스예요."
        },
        {
          "t": "질병관리청 국가건강정보포털도 그렇게 설명해요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "옮는 길은 세 가지예요."
        },
        {
          "t": "오염된 물이나 음식을 먹을 때,"
        },
        {
          "t": "환자의 분변이나 구토물이 묻은 손과 물건을 만질 때,"
        },
        {
          "t": "그리고 토할 때 튄 비말로도 옮아요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "바이러스가 주변 환경에서 수일 동안 살아남을 수 있어서",
          "s": "red"
        },
        {
          "t": "문손잡이와 수도꼭지가 다리 역할을 해요.",
          "s": "red"
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "걸리면 어떤 증상이 생길까"
        }
      ]
    },
    {
      "type": "image",
      "n": 3,
      "lines": [
        {
          "t": "침대 옆 탁자에 물컵과 보온병을 놓아 주는 50대 남성"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "보통 감염되고 1~2일 안에 구토와 설사가 나타나요.",
          "segs": [
            {
              "t": "보통 감염되고 "
            },
            {
              "t": "1~2일",
              "s": "blue"
            },
            {
              "t": " 안에 구토와 설사가 나타나요."
            }
          ]
        },
        {
          "t": "대부분 2~3일이 지나면 저절로 회복돼요.",
          "segs": [
            {
              "t": "대부분 "
            },
            {
              "t": "2~3일",
              "s": "blue"
            },
            {
              "t": "이 지나면 저절로 회복돼요."
            }
          ]
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "며칠이면 지나간다는 게 위안이 되지만,"
        },
        {
          "t": "그 며칠 동안 가족에게 옮기 쉬운 게 문제예요."
        },
        {
          "t": "아픈 사람을 돌보는 사람이 다음 차례가 되거든요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "이때 꼭 살펴야 할 건 탈수예요.",
          "s": "yellow"
        },
        {
          "t": "특히 아이와 어르신은 물을 잃는 속도가 빨라요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "한 번에 많이 마시기 어려우면"
        },
        {
          "t": "조금씩 자주 마시게 도와주세요."
        },
        {
          "t": "토한 직후에는 잠깐 쉬었다가 천천히 시작해요."
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "이런 탈수 신호는 놓치지 마세요"
        }
      ]
    },
    {
      "type": "image",
      "n": 4,
      "lines": [
        {
          "t": "노로바이러스 때 살펴볼 탈수 신호를 정리한 카드"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "포털이 꼽는 탈수 신호는 이래요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "✔ 소변 양이 줄었다"
        },
        {
          "t": "✔ 입과 목이 바짝 마른다"
        },
        {
          "t": "✔ 어지럽다"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "✔ 울어도 눈물이 적다"
        },
        {
          "t": "✔ 평소와 달리 자꾸 존다"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "이런 탈수 신호가 보이면 집에서 버티지 말고",
          "s": "red"
        },
        {
          "t": "진료를 받아 보세요.",
          "s": "red"
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "집에서 옮지 않게 하는 법"
        }
      ]
    },
    {
      "type": "image",
      "n": 5,
      "lines": [
        {
          "t": "집에서 노로바이러스가 옮지 않게 하는 수칙을 정리한 카드"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "환자가 생기면 집 안 수칙부터 바꿔요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "✔ 비누로 30초 이상 손씻기"
        },
        {
          "t": "✔ 변기 뚜껑 닫고 물 내리기"
        },
        {
          "t": "✔ 환자와 생활공간 나누기"
        },
        {
          "t": "✔ 아픈 사람은 음식 만들지 않기"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "손씻기는 흐르는 물에 비누로 30초 이상이에요.",
          "segs": [
            {
              "t": "손씻기는 흐르는 물에 비누로 "
            },
            {
              "t": "30초",
              "s": "blue"
            },
            {
              "t": " 이상이에요."
            }
          ]
        },
        {
          "t": "용변 뒤, 식사 전후, 외출 전후 모두요."
        },
        {
          "t": "음식은 85℃ 이상에서 1분 이상 익혀 먹어요.",
          "segs": [
            {
              "t": "음식은 "
            },
            {
              "t": "85℃",
              "s": "blue"
            },
            {
              "t": " 이상에서 "
            },
            {
              "t": "1분",
              "s": "blue"
            },
            {
              "t": " 이상 익혀 먹어요."
            }
          ]
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "채소와 과일은 흐르는 물에 씻고 껍질을 벗겨 먹어요."
        },
        {
          "t": "칼과 도마는 채소용, 고기용, 생선용으로"
        },
        {
          "t": "나눠 쓰면 주방에서 옮는 길도 줄일 수 있어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "변기 뚜껑을 닫고 물을 내리는 것도 같은 이유예요."
        },
        {
          "t": "물이 내려갈 때 튀는 비말을 줄이는 거죠."
        },
        {
          "t": "환자가 쓰는 화장실을 따로 정할 수 있으면 더 좋아요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "수건은 식구마다 따로 쓰는 게 좋아요."
        },
        {
          "t": "손을 씻고 같은 수건으로 닦으면"
        },
        {
          "t": "씻은 보람이 줄어들 수 있으니까요."
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "구토물 치울 때와 빨래할 때"
        }
      ]
    },
    {
      "type": "image",
      "n": 6,
      "lines": [
        {
          "t": "고무장갑과 마스크를 끼고 바닥을 닦는 40대 여성"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "구토물이 묻은 곳과 물건은 염소 소독을 해요."
        },
        {
          "t": "가정용 락스를 물과 1:50으로 희석해 써요.",
          "segs": [
            {
              "t": "가정용 락스를 물과 "
            },
            {
              "t": "1:50",
              "s": "blue"
            },
            {
              "t": "으로 희석해 써요."
            }
          ]
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "구토물 치울 땐 장갑과 마스크를 먼저 챙겨요.",
          "s": "yellow"
        },
        {
          "t": "환자가 쓴 이불과 옷은 따로 모아 두세요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "빨래는 70℃ 이상 물로 빨거나,",
          "segs": [
            {
              "t": "빨래는 "
            },
            {
              "t": "70℃",
              "s": "blue"
            },
            {
              "t": " 이상 물로 빨거나,"
            }
          ]
        },
        {
          "t": "락스와 물을 1:330으로 희석한 물에"
        },
        {
          "t": "5분 이상 헹구는 방법이 있어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "증상이 사라진 뒤 48시간까지는",
          "s": "yellow"
        },
        {
          "t": "등원·등교·출근을 쉬어요.",
          "s": "yellow"
        },
        {
          "t": "나아 보여도 바이러스가 남아 있을 수 있어서예요."
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "노로바이러스 Q&A"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "노로바이러스에 많이 묻는 두 가지예요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "Q1: 노로바이러스는 왜 겨울에 많아요?"
        },
        {
          "t": "A1: 기온이 내려가면서 손씻기 같은 위생이 느슨해지고"
        },
        {
          "t": "실내에 모여 지내는 시간이 늘어서 옮기 쉬워져요."
        },
        {
          "t": "특히 12월과 1월에 많이 생긴다고 해요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "Q2: 손 소독제만 써도 되나요?"
        },
        {
          "t": "A2: 포털은 흐르는 물에 비누로"
        },
        {
          "t": "30초 이상 손씻기를 권해요."
        },
        {
          "t": "아픈 가족이 있을 땐 비누 손씻기를 기본으로 해요."
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "노로바이러스 정리"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "여러분 댁은 누가 먼저 걸렸나요?"
        },
        {
          "t": "아이, 엄마, 아빠 중 한 단어로 남겨 주세요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "노로바이러스는 손씻기와 구토물 소독,",
          "s": "red"
        },
        {
          "t": "그리고 탈수 살피기 이 세 가지가 핵심이에요.",
          "s": "red"
        },
        {
          "t": "걱정은 내려놓고 오늘 할 수 있는 것부터 해요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "한 사람이 아팠다고 해서 누구 탓도 아니에요."
        },
        {
          "t": "돌보는 사람이 먼저 손을 씻고 장갑을 끼면"
        },
        {
          "t": "가족 모두를 지키는 데 큰 힘이 돼요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "오늘 욕실 세면대 옆에 비누가 있는지,"
        },
        {
          "t": "락스가 어디 있는지 한 번만 확인해 두세요."
        },
        {
          "t": "정확한 판단은 진료받는 병원에서 해 주세요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "오늘 내용은 질병관리청 국가건강정보포털의"
        },
        {
          "t": "겨울철 노로바이러스 감염 자료에서"
        },
        {
          "t": "확인한 정보를 바탕으로 정리했어요."
        },
        {
          "t": "(2026년 11월 기준이라 이후 달라질 수 있어요)"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "좋아요·공감과 이웃추가 부탁드려요💙"
        },
        {
          "t": "이상 성글벙글의 생활보장 포스팅이었습니다😎"
        }
      ]
    }
  ]
}
