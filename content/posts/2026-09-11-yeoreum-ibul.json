  "blocks": [
    {
      "type": "p",
      "lines": [
        {
          "t": "아침저녁으로 선선해졌습니다."
        },
        {
          "t": "여름이불을 정리할 때가 됐죠."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "그런데 급하게 개서 넣어두면"
        },
        {
          "t": "내년에 꺼낼 때",
          "s": "red"
        },
        {
          "t": "눅눅한 냄새가 배어 있습니다.",
          "s": "red"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "보관 전에 세 가지만 확인하면"
        },
        {
          "t": "이런 일을 줄일 수 있습니다."
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "1. 세탁보다 완전 건조"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "덜 마른 채로 넣는 것이"
        },
        {
          "t": "가장 흔한 실수입니다."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "겉은 보송해 보여도"
        },
        {
          "t": "속까지 말라야 합니다.",
          "s": "yellow"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "속이 젖어 있으면 그 습기가"
        },
        {
          "t": "장 안에 그대로 갇힙니다."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "흐린 날에는 선풍기 바람을"
        },
        {
          "t": "쐬어주는 것도 방법입니다."
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "2. 압축팩은 끝까지 빼지 않기"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "부피는 줄어들지만 솜이 눌려"
        },
        {
          "t": "복원이 잘 되지 않습니다."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "여유를 조금 남겨두세요.",
          "s": "yellow"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "한번 눌린 솜은 털어도"
        },
        {
          "t": "쉽게 돌아오지 않습니다."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "극세사나 구스 소재는"
        },
        {
          "t": "그 차이가 특히 눈에 띕니다."
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "3. 방충제는 직접 닿지 않게"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "천에 바로 닿으면"
        },
        {
          "t": "변색되거나 냄새가 뱁니다."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "얇은 천에 싸서"
        },
        {
          "t": "이불 옆에 두는 정도면 됩니다."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "냄새가 한번 배면"
        },
        {
          "t": "결국 다시 세탁해야 합니다."
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "정리"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "완전 건조,",
          "s": "red"
        },
        {
          "t": "압축은 여유 있게,",
          "s": "red"
        },
        {
          "t": "방충제는 간접 배치.",
          "s": "red"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "오늘 이불을 꺼내실 계획이라면"
        },
        {
          "t": "세탁 시간보다 말리는 시간을"
        },
        {
          "t": "먼저 확보해 두세요."
        }
      ]
    }
