  "blocks": [
    {
      "type": "p",
      "lines": [
        {
          "t": "골다공증 전단계에 해당하는 골감소증은"
        },
        {
          "t": "50세 이상 성인 두 명 중 한 명꼴이에요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "오늘은 골감소증이라는 말을 들었을 때"
        },
        {
          "t": "무엇을 알고, 무엇을 바꾸면 되는지 볼게요."
        },
        {
          "t": "답은 검사 숫자 읽기와 생활 세 가지예요."
        }
      ]
    },
    {
      "type": "image",
      "n": 1,
      "lines": [
        {
          "t": "건강검진 결과를 들은 뒤 운동화 끈을 묶으며 마음을 다잡는 50대 여성의 얼굴 (대표사진)"
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "골감소증, 골다공증과 무엇이 다를까"
        }
      ]
    },
    {
      "type": "image",
      "n": 2,
      "lines": [
        {
          "t": "검진센터 상담실에서 의사의 설명을 듣는 50대 여성"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "골감소증은 뼈가 약해졌지만"
        },
        {
          "t": "아직 골다공증까지는 아닌 상태예요."
        },
        {
          "t": "질병관리청 국가건강정보포털은 이를",
          "segs": [
            {
              "t": "질병관리청",
              "s": "blue"
            },
            {
              "t": " 국가건강정보포털은 이를"
            }
          ]
        },
        {
          "t": "골다공증의 전 단계라고 설명해요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "왜 관리하라고 하냐면, 증상이 없거든요."
        },
        {
          "t": "골절이 생기기 전까지는",
          "s": "red"
        },
        {
          "t": "아픈 곳이 없어 모르고 지나가기 쉬워요.",
          "s": "red"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "골량은 30대까지 늘다가 50세까지 유지되고,"
        },
        {
          "t": "그 뒤로는 나이가 들며 줄어든다고 해요."
        },
        {
          "t": "여성은 폐경 무렵 뼈가 빠르게 줄어"
        },
        {
          "t": "이때 골밀도를 한 번 보는 게 좋다고 해요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "남성도 예외는 아니에요."
        },
        {
          "t": "50세 이상 골감소증 유병률이 여성 48.9%,"
        },
        {
          "t": "남성 46.8%로 비슷했다고 해요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "나이 말고도 뼈를 줄이는 요인이 있어요."
        },
        {
          "t": "저체중, 흡연, 음주, 가족력이 대표적이고,"
        },
        {
          "t": "스테로이드 같은 약을 오래 드셔도 영향을 받아요."
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "T 점수, 검사지에서 이렇게 읽어요"
        }
      ]
    },
    {
      "type": "image",
      "n": 3,
      "lines": [
        {
          "t": "T 점수 기준을 정리한 카드"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "골감소증은 증상으로는 알기 어렵고"
        },
        {
          "t": "골밀도 검사로 알 수 있어요."
        },
        {
          "t": "결과는 T 점수로 나오는데,",
          "segs": [
            {
              "t": "결과는 "
            },
            {
              "t": "T 점수",
              "s": "blue"
            },
            {
              "t": "로 나오는데,"
            }
          ]
        },
        {
          "t": "젊고 건강한 성인의 평균과 견준 값이에요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "✔ -1.0 이상: 정상"
        },
        {
          "t": "✔ 그 사이: 골감소증"
        },
        {
          "t": "✔ -2.5 이하: 골다공증"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "T 점수는 낮을수록 골밀도가 낮다는 뜻이에요.",
          "s": "yellow"
        },
        {
          "t": "보통 허리뼈와 대퇴골을 재고,"
        },
        {
          "t": "그중 가장 낮은 값을 기준으로 봐요."
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "비타민 D와 칼슘, 식탁에서 챙겨요"
        }
      ]
    },
    {
      "type": "image",
      "n": 4,
      "lines": [
        {
          "t": "아침 식탁에 우유, 두부, 멸치볶음, 채소 반찬이 놓인 모습"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "바꿀 첫째는 식탁이에요."
        },
        {
          "t": "대한골대사학회는 칼슘을 하루",
          "segs": [
            {
              "t": "대한골대사학회",
              "s": "blue"
            },
            {
              "t": "는 칼슘을 하루"
            }
          ]
        },
        {
          "t": "800~1,000mg 섭취하라고 권해요.",
          "segs": [
            {
              "t": "800~1,000mg",
              "s": "blue"
            },
            {
              "t": " 섭취하라고 권해요."
            }
          ]
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "비타민 D는 하루 800IU가 권장량이에요.",
          "segs": [
            {
              "t": "비타민 D는 하루 "
            },
            {
              "t": "800IU",
              "s": "blue"
            },
            {
              "t": "가 권장량이에요."
            }
          ]
        },
        {
          "t": "음식으로 먼저 채우고, 어려우면"
        },
        {
          "t": "보충제는 진료받는 곳과 상의해요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "짠 음식은 칼슘이 소변으로 더 빠지게 해요."
        },
        {
          "t": "국물과 짠 반찬을 덜어 내는 것도 뼈 관리예요.",
          "s": "yellow"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "단백질은 뼈의 기본 틀이라 충분히 먹는 게 좋아요."
        },
        {
          "t": "과일과 채소에 든 칼륨도 골밀도에 도움이 된다고 해요."
        },
        {
          "t": "고기·생선·두부에 채소 반찬 하나면 시작이에요."
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "운동은 세 가지를 같이 해요"
        }
      ]
    },
    {
      "type": "image",
      "n": 5,
      "lines": [
        {
          "t": "골감소증 관리 운동 세 가지를 정리한 카드"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "둘째는 운동이에요."
        },
        {
          "t": "한 가지만 하기보다 섞는 게 좋다고 해요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "✔ 걷기 같은 유산소 운동"
        },
        {
          "t": "✔ 근력을 키우는 저항 운동"
        },
        {
          "t": "✔ 균형 감각을 키우는 운동"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "처음부터 무리할 필요는 없어요."
        },
        {
          "t": "걷기부터 시작해 몸이 익숙해지면"
        },
        {
          "t": "근력과 균형 운동을 하나씩 더해 가면 돼요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "셋째는 넘어지지 않기예요."
        },
        {
          "t": "골감소증에서는 대개 넘어지면서",
          "s": "red"
        },
        {
          "t": "골절이 생겨 낙상 예방이 중요해요.",
          "s": "red"
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "골감소증 Q&A"
        }
      ]
    },
    {
      "type": "image",
      "n": 6,
      "lines": [
        {
          "t": "점심 무렵 공원 벤치에서 소매를 걷고 햇볕을 쬐는 60대 남성"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "골감소증을 들은 분들이 많이 묻는 네 가지예요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "Q1: 골감소증이면 약을 먹어야 하나요?"
        },
        {
          "t": "A1: 모든 골감소증 환자가 약을 먹는 건 아니에요."
        },
        {
          "t": "골절이 함께 있거나 골절 위험이 높게 나오면"
        },
        {
          "t": "약물 치료를 고려한다고 해요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "골절 위험은 10년 안에 골절이 생길 확률을"
        },
        {
          "t": "내다보는 도구(FRAX)로 따져 보기도 해요."
        },
        {
          "t": "어느 쪽이 맞는지는 진료에서 함께 정해요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "Q2: 골밀도 검사는 얼마나 자주 받나요?"
        },
        {
          "t": "A2: 포털은 정기적으로 골밀도 검사를 받아"
        },
        {
          "t": "변화를 지켜보라고 해요."
        },
        {
          "t": "간격은 결과를 본 병원에서 정해요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "지난 결과지를 모아 두면 변화를 보기 쉬워요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "Q3: 햇볕만 쬐면 비타민 D가 채워질까요?"
        },
        {
          "t": "A3: 맨살에 햇빛이 닿아야 만들어져요."
        },
        {
          "t": "유리창 너머 햇빛은 효과가 적고,"
        },
        {
          "t": "낮 12~2시 사이 15분 정도가 좋다고 해요.",
          "segs": [
            {
              "t": "낮 "
            },
            {
              "t": "12~2시",
              "s": "blue"
            },
            {
              "t": " 사이 15분 정도가 좋다고 해요."
            }
          ]
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "Q4: 커피와 술은 어느 정도까지 괜찮을까요?"
        },
        {
          "t": "A4: 카페인은 하루 1~2잔 이하로 줄이고,"
        },
        {
          "t": "술은 하루 2잔 넘게 마시지 않는 게 좋아요."
        },
        {
          "t": "콜라 같은 탄산음료도 줄이라고 해요."
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "골감소증 정리"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "여러분은 하루 커피 몇 잔 드세요?"
        },
        {
          "t": "숫자 하나로 남겨 주세요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "골감소증은 증상이 없을 때가",
          "s": "red"
        },
        {
          "t": "관리를 시작하기 좋은 때예요.",
          "s": "red"
        },
        {
          "t": "T 점수를 확인하고, 식탁·운동·낙상 예방을 챙겨요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "오늘은 검사지의 T 점수부터 찾아 적어 보세요.",
          "s": "yellow"
        },
        {
          "t": "다음 골밀도 검사 때 견줘 볼 기준이 돼요."
        },
        {
          "t": "정확한 판단은 진료받는 병원에서 해 주세요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "오늘 내용은 질병관리청 국가건강정보포털의"
        },
        {
          "t": "「골감소증」 자료에서"
        },
        {
          "t": "확인한 정보를 바탕으로 정리했어요."
        },
        {
          "t": "(2026년 11월 기준이라 이후 달라질 수 있어요)"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "좋아요·공감과 이웃추가 부탁드려요💙"
        },
        {
          "t": "이상 성글벙글의 생활보장 포스팅이었습니다😎"
        }
      ]
    }
