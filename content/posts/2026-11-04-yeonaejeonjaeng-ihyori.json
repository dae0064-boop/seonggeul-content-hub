  "blocks": [
    {
      "type": "p",
      "lines": [
        {
          "t": "이번 연애전쟁에는 코미디언 김원훈과 엄지윤이"
        },
        {
          "t": "특별 외교관으로 함께 나왔어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "월요일 밤 방송된 연애전쟁 이효리의 한마디가"
        },
        {
          "t": "어제 하루 연예 소식을 크게 달궜어요."
        },
        {
          "t": "\"나도 정신과에 정기적으로 다닌다\"는 말이었어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "예를 들어 마음이 힘들어도"
        },
        {
          "t": "\"병원까지 갈 일은 아니지\" 하고 넘기는 분이라면"
        },
        {
          "t": "이 장면이 오래 남았을 거예요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "오늘은 연애전쟁 이효리 장면을"
        },
        {
          "t": "방송에 나온 내용 그대로 정리해 볼게요."
        },
        {
          "t": "사연 속 커플은 일반인이라 이름 없이 적을게요."
        }
      ]
    },
    {
      "type": "image",
      "n": 1,
      "lines": [
        {
          "t": "연애전쟁 출연자 사진 (대표사진)"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "[사진 출처 1]"
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "연애전쟁 이효리, 어떤 장면이었나"
        }
      ]
    },
    {
      "type": "image",
      "n": 2,
      "lines": [
        {
          "t": "밤 거실 소파와 꺼진 텔레비전"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "11월 2일 방송된 JTBC 연애전쟁에는",
          "segs": [
            {
              "t": "11월 2일",
              "s": "blue"
            },
            {
              "t": " 방송된 JTBC 연애전쟁에는"
            }
          ]
        },
        {
          "t": "술 문제로 자주 다투는 커플의 사연이 나왔어요."
        },
        {
          "t": "술을 마시면 감정이 크게 흔들린다는 이야기였어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "두 사람은 술자리 뒤 다툼이 잦았고"
        },
        {
          "t": "금주 약속도 여러 번 어겼다고 했어요."
        },
        {
          "t": "화면을 보던 출연진의 표정도 점점 굳어 갔어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "이효리는 두 사람에게 병원에",
          "s": "yellow"
        },
        {
          "t": "함께 가 보라고 권했어요.",
          "s": "yellow"
        },
        {
          "t": "그러면서 47세인 자신의 경험을 꺼냈어요.",
          "segs": [
            {
              "t": "그러면서 "
            },
            {
              "t": "47세",
              "s": "blue"
            },
            {
              "t": "인 자신의 경험을 꺼냈어요."
            }
          ]
        },
        {
          "t": "쉽게 하기 어려운 이야기를 먼저 꺼낸 거예요."
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "정신건강의학과, 건강검진처럼"
        }
      ]
    },
    {
      "type": "image",
      "n": 3,
      "lines": [
        {
          "t": "출연자 조언을 정리한 카드"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "이효리는 생활에 큰 지장이 없어도"
        },
        {
          "t": "정신건강의학과를 정기적으로 찾는다고 말했어요."
        },
        {
          "t": "건강검진을 받듯이 한 번씩 간다고 했어요.",
          "s": "red"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "\"스스로 문제없다고 단정하지 말고"
        },
        {
          "t": "한번 점검해 보라\"는 뜻이었어요."
        },
        {
          "t": "술에 기대는 습관이 있는지도 보라고 했어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "이 말에 \"나도 가 볼까\" 하는 반응과"
        },
        {
          "t": "\"솔직해서 더 와닿는다\"는 말이 이어졌어요."
        },
        {
          "t": "아픈 사람만 가는 곳이라는 생각을",
          "s": "yellow"
        },
        {
          "t": "조금 덜어 준 장면이었어요.",
          "s": "yellow"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "몸이 괜찮아도 건강검진을 받듯"
        },
        {
          "t": "마음도 미리 살펴보자는 이야기예요."
        },
        {
          "t": "병원 문턱을 낮춰 준 말이라는 반응이 많았어요."
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "서장훈과 출연진의 반응"
        }
      ]
    },
    {
      "type": "image",
      "n": 4,
      "lines": [
        {
          "t": "녹화 스튜디오의 빈 의자와 조명"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "서장훈은 술에 취한 사람을 애교로"
        },
        {
          "t": "달랠 수는 없다고 짚었어요."
        },
        {
          "t": "약속을 거듭 어기는 모습도 꼬집었어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "서장훈은 이런 관계를 이어 가는 게",
          "s": "yellow"
        },
        {
          "t": "이해되지 않는다고도 말했어요.",
          "s": "yellow"
        },
        {
          "t": "평소처럼 짧고 분명한 말투였어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "서장훈의 직설과 이효리의 다독임이"
        },
        {
          "t": "나란히 놓이면서 장면이 더 또렷해졌어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "김원훈과 엄지윤도 화면을 보며"
        },
        {
          "t": "\"그건 아니지\" 하고 고개를 저었어요."
        },
        {
          "t": "출연진 모두 두 사람의 안전을 먼저 걱정했어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "웃음이 많은 두 코미디언도"
        },
        {
          "t": "이날만큼은 진지한 얼굴이었어요."
        },
        {
          "t": "그만큼 사연이 가볍지 않았다는 뜻이에요."
        },
        {
          "t": "보는 사람도 마음이 무거워지는 회였어요."
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "술 문제, 이효리의 조언"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "이효리는 영상 속 장면을 보고"
        },
        {
          "t": "\"위험하다\"며 단호하게 말했어요.",
          "s": "red"
        },
        {
          "t": "장난처럼 보여도 멍이 들 정도면 넘어선 거라고 했어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "마지막에는 두 사람에게"
        },
        {
          "t": "헤어지거나 연애를 잠시 쉬라고 권했어요."
        },
        {
          "t": "술 문제는 두 사람 모두에게 있었다는 점도 나왔어요."
        },
        {
          "t": "서로 다른 사람을 만나라는 말까지 했어요.",
          "segs": [
            {
              "t": "서로 다른 사람을 만나라",
              "s": "blue"
            },
            {
              "t": "는 말까지 했어요."
            }
          ]
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "연애전쟁 이효리 조언이 화제가 된 건"
        },
        {
          "t": "날카롭기보다 걱정이 담겨 있어서였어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "\"왜 저렇게까지 말해?\" 하는 분도 있었지만"
        },
        {
          "t": "\"그래서 더 진심 같다\"는 말이 더 많았어요."
        },
        {
          "t": "누구 편을 들기보다 두 사람을 걱정한 말이었어요."
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "연애전쟁 이효리 Q&A"
        }
      ]
    },
    {
      "type": "image",
      "n": 5,
      "lines": [
        {
          "t": "연애전쟁 방송 정보를 정리한 카드"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "연애전쟁 이효리 장면에 많이 묻는 두 가지예요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "Q1: 연애전쟁은 언제 하나요?"
        },
        {
          "t": "A1: JTBC에서 월요일 밤에 방송해요.",
          "segs": [
            {
              "t": "A1: "
            },
            {
              "t": "JTBC",
              "s": "blue"
            },
            {
              "t": "에서 "
            },
            {
              "t": "월요일",
              "s": "blue"
            },
            {
              "t": " 밤에 방송해요."
            }
          ]
        },
        {
          "t": "갈등을 겪는 커플의 사연을 듣고"
        },
        {
          "t": "출연진이 함께 이야기를 나누는 예능이에요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "Q2: 정신건강의학과는 어떻게 가나요?"
        },
        {
          "t": "A2: 동네 정신건강의학과 의원에"
        },
        {
          "t": "진료 예약을 하면 돼요."
        },
        {
          "t": "지역 정신건강복지센터에서도 상담을 받을 수 있어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "급할 때는 정신건강 위기상담전화"
        },
        {
          "t": "1577-0199로 언제든 이야기할 수 있어요.",
          "segs": [
            {
              "t": "1577-0199",
              "s": "blue"
            },
            {
              "t": "로 언제든 이야기할 수 있어요."
            }
          ]
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "연애전쟁 이효리, 정리하면"
        }
      ]
    },
    {
      "type": "image",
      "n": 6,
      "lines": [
        {
          "t": "아침 햇살이 드는 창가의 찻잔"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "여러분은 마음 건강도 몸처럼"
        },
        {
          "t": "챙기는 편이세요? 한다, 안 한다로 남겨 주세요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "연애전쟁 이효리 고백의 핵심은",
          "s": "red"
        },
        {
          "t": "'점검은 아플 때만 하는 게 아니다'였어요.",
          "s": "red"
        },
        {
          "t": "술 문제든 마음의 문제든"
        },
        {
          "t": "혼자 판단하기보다 한번 점검받는 게 먼저예요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "마음이 계속 무겁다면 혼자 버티지 말고",
          "s": "yellow"
        },
        {
          "t": "가까운 정신건강의학과를 찾아보세요.",
          "s": "yellow"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "오늘 내용은 텐아시아·파이낸셜뉴스 등의 보도에서"
        },
        {
          "t": "확인한 정보를 바탕으로 정리했어요."
        },
        {
          "t": "(2026년 11월 기준이라 이후 달라질 수 있어요)"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "좋아요·공감과 이웃추가 부탁드려요💙"
        },
        {
          "t": "이상 성글벙글의 예능 이야기 포스팅이었습니다😎"
        }
      ]
    }
