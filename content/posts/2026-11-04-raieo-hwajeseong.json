  ],
  "issue": "연예",
  "topic": "드라마",
  "blocks": [
    {
      "type": "p",
      "lines": [
        {
          "t": "라이어는 첫 주 만에 디즈니플러스와"
        },
        {
          "t": "웨이브 드라마 순위 1위에 올랐어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "새로 시작한 라이어 드라마가 묘한 기록을 세웠어요."
        },
        {
          "t": "시청률은 1%대인데 화제성은 1위였거든요."
        },
        {
          "t": "어제 연예 랭킹에도 이 이야기가 올랐어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "예를 들어 금요일 밤 본방을 놓치고"
        },
        {
          "t": "다음 날 OTT로 몰아 본 분이라면"
        },
        {
          "t": "2회 마지막 5분에 \"어?\" 하셨을 거예요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "오늘은 라이어 드라마 첫 주를"
        },
        {
          "t": "방송에 나온 내용과 숫자로 정리해 볼게요."
        },
        {
          "t": "아직 밝혀지지 않은 진실은 추측하지 않고"
        },
        {
          "t": "방송에 나온 장면까지만 짚어 볼게요."
        }
      ]
    },
    {
      "type": "image",
      "n": 1,
      "lines": [
        {
          "t": "라이어 공식 영상 장면 (대표사진)"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "[사진 출처 1]"
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "라이어 드라마, 어떤 이야기일까"
        }
      ]
    },
    {
      "type": "image",
      "n": 2,
      "lines": [
        {
          "t": "라이어 2회 장면 (공식 영상 인용)"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "[사진 출처 2]"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "라이어는 MBC 금토드라마로"
        },
        {
          "t": "10월 30일 첫 방송을 했어요.",
          "segs": [
            {
              "t": "10월 30일",
              "s": "blue"
            },
            {
              "t": " 첫 방송을 했어요."
            }
          ]
        },
        {
          "t": "유연석과 서현진이 주인공인 심리 스릴러예요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "첫 회는 서현진이 연기한 강지선이"
        },
        {
          "t": "피해를 주장하고, 유연석이 연기한 인물이"
        },
        {
          "t": "체포되면서 진실 공방이 시작됐어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "누구 말이 진짜인지 끝까지 알 수 없는",
          "s": "yellow"
        },
        {
          "t": "구성이 이 드라마의 핵심이에요.",
          "s": "yellow"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "유연석과 서현진은 SBS '낭만닥터 김사부'에서"
        },
        {
          "t": "함께했던 사이라 다시 만난 것도 화제였어요."
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "거짓말 탐지기, 2회 엔딩의 반전"
        }
      ]
    },
    {
      "type": "image",
      "n": 3,
      "lines": [
        {
          "t": "라이어 첫 주 흐름을 정리한 카드"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "2회 마지막 5분에"
        },
        {
          "t": "거짓말 탐지기 조사 결과가 나왔어요."
        },
        {
          "t": "거짓말을 한 쪽으로 지목된 건",
          "s": "red"
        },
        {
          "t": "뜻밖에도 강지선이었어요.",
          "s": "red"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "그동안 시청자는 강지선 편에서 이야기를 따라왔어요."
        },
        {
          "t": "그런데 결과가 반대로 나오면서"
        },
        {
          "t": "의심의 방향이 한순간에 바뀌었어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "\"그럼 지금까지 본 게 다 거짓말이야?\" 하는 반응에"
        },
        {
          "t": "\"아직 2회라 모른다\"는 말도 많았어요."
        },
        {
          "t": "진실은 아직 방송에서 밝혀지지 않았어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "그래서 2회를 보고 1회를 다시 찾아보는 분이 많아요."
        },
        {
          "t": "처음 장면이 다르게 보인다는 말이 이어졌어요."
        },
        {
          "t": "라이어 드라마가 다시 보기로 더 찾게 되는 이유예요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "거짓말 탐지기 결과가 곧 진실이라는 뜻은 아니에요."
        },
        {
          "t": "드라마는 이 결과를 두고도"
        },
        {
          "t": "여러 갈래의 의심을 남겨 두었어요."
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "라이어 드라마 시청률, 몇 퍼센트"
        }
      ]
    },
    {
      "type": "image",
      "n": 4,
      "lines": [
        {
          "t": "라이어 장면 (공식 영상 인용)"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "[사진 출처 4]"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "1회와 2회 시청률은 모두 전국 1.9%예요.",
          "segs": [
            {
              "t": "1회와 2회 시청률은 모두 전국 "
            },
            {
              "t": "1.9%",
              "s": "blue"
            },
            {
              "t": "예요."
            }
          ]
        },
        {
          "t": "1회 분당 최고는 수도권 4.8%까지 올랐어요.",
          "segs": [
            {
              "t": "1회 분당 최고는 수도권 "
            },
            {
              "t": "4.8%",
              "s": "blue"
            },
            {
              "t": "까지 올랐어요."
            }
          ]
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "같은 시간대에 SBS '닥터X'가 방송하고 있어"
        },
        {
          "t": "본방 시청률만 보면 아쉬운 출발이에요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "토요일 밤에는 tvN '100일의 거짓말'도"
        },
        {
          "t": "함께 방송하고 있어요."
        },
        {
          "t": "주말 밤 드라마 경쟁이 그만큼 치열한 셈이에요."
        },
        {
          "t": "다만 OTT 쪽 반응은 전혀 달랐어요.",
          "s": "yellow"
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "유연석 서현진 라이어, 화제성은 1위"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "라이어는 10월 5주차 드라마 화제성 조사에서",
          "segs": [
            {
              "t": "라이어는 "
            },
            {
              "t": "10월 5주차",
              "s": "blue"
            },
            {
              "t": " 드라마 화제성 조사에서"
            }
          ]
        },
        {
          "t": "뉴스 기사 수 1위를 차지했어요."
        },
        {
          "t": "디즈니플러스와 웨이브 순위에서도 1위였어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "해외에서도 14개국 디즈니플러스",
          "segs": [
            {
              "t": "해외에서도 "
            },
            {
              "t": "14개국",
              "s": "blue"
            },
            {
              "t": " 디즈니플러스"
            }
          ]
        },
        {
          "t": "TV쇼 10위 안에 들었다는 보도가 나왔어요."
        },
        {
          "t": "본방보다 다시 보기로 찾는 사람이 많다는 뜻이에요."
        },
        {
          "t": "시청률 숫자만으로는 보이지 않는 인기예요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "유연석의 차분한 얼굴과 서현진의 흔들리는 눈빛이"
        },
        {
          "t": "한 장면 안에서 부딪히는 게 볼거리라는 평이 많아요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "두 배우 모두 오랜만의 스릴러 연기라"
        },
        {
          "t": "연기 변신을 보러 왔다는 시청자도 많아요."
        },
        {
          "t": "말 한마디, 표정 하나에 단서가 숨어 있어",
          "s": "yellow"
        },
        {
          "t": "집중해서 보게 되는 드라마예요.",
          "s": "yellow"
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "라이어 드라마 Q&A"
        }
      ]
    },
    {
      "type": "image",
      "n": 5,
      "lines": [
        {
          "t": "라이어 시청률과 일정을 정리한 카드"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "라이어 드라마에 많이 묻는 두 가지예요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "Q1: 라이어는 언제, 어디서 보나요?"
        },
        {
          "t": "A1: MBC에서 금·토요일 밤에 방송해요.",
          "segs": [
            {
              "t": "A1: MBC에서 "
            },
            {
              "t": "금·토요일 밤",
              "s": "blue"
            },
            {
              "t": "에 방송해요."
            }
          ]
        },
        {
          "t": "디즈니플러스와 웨이브에서도 볼 수 있어요."
        },
        {
          "t": "본방을 놓쳤다면 다시 보기로 1회부터 챙겨 보세요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "Q2: 3회는 언제 하나요?"
        },
        {
          "t": "A2: 11월 6일(금) 밤에 이어져요.",
          "segs": [
            {
              "t": "A2: "
            },
            {
              "t": "11월 6일(금)",
              "s": "blue"
            },
            {
              "t": " 밤에 이어져요."
            }
          ]
        },
        {
          "t": "거짓말 탐지기 결과 뒤 강지선이 어떻게 나올지가"
        },
        {
          "t": "가장 궁금한 대목이에요."
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "라이어 드라마, 정리하면"
        }
      ]
    },
    {
      "type": "image",
      "n": 6,
      "lines": [
        {
          "t": "비 오는 밤 창문에 맺힌 물방울"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "여러분은 지금까지 보신 라이어에서"
        },
        {
          "t": "누구 말을 믿으세요?"
        },
        {
          "t": "강지선, 상대 쪽 한마디로 남겨 주세요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "라이어 드라마는 시청률보다",
          "s": "red"
        },
        {
          "t": "OTT 화제성이 먼저 터진 드라마예요.",
          "s": "red"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "진실은 아직 밝혀지지 않았으니",
          "s": "red"
        },
        {
          "t": "추측보다 다음 회를 기다려 보세요.",
          "s": "red"
        },
        {
          "t": "금요일 3회 전에 2회 엔딩을",
          "s": "yellow"
        },
        {
          "t": "다시 보고 가면 더 재밌어요.",
          "s": "yellow"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "오늘 내용은 조이뉴스24·일간스포츠 등의 보도에서"
        },
        {
          "t": "확인한 정보를 바탕으로 정리했어요."
        },
        {
          "t": "(2026년 11월 기준이라 이후 달라질 수 있어요)"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "좋아요·공감과 이웃추가 부탁드려요💙"
        },
        {
          "t": "이상 성글벙글의 드라마 이야기 포스팅이었습니다😎"
        }
      ]
    }
  ]
