    },
    {
      "type": "p",
      "lines": [
        {
          "t": "대여가격은 월 단위"
        },
        {
          "t": "15일보다 짧으면 15일로"
        },
        {
          "t": "입원 중엔 최대 15일"
        },
        {
          "t": "사망 뒤엔 최대 7일"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "대여가격은 월 단위로 정해요.",
          "segs": [
            {
              "t": "대여가격은 "
            },
            {
              "t": "월 단위",
              "s": "blue"
            },
            {
              "t": "로 정해요."
            }
          ]
        },
        {
          "t": "달 중간에 시작하거나 끝나면 날짜만큼 계산하고,"
        },
        {
          "t": "연속으로 빌린 날이 15일보다 짧으면"
