  "blocks": [
    {
      "type": "p",
      "lines": [
        {
          "t": "어깨 물리치료처럼 건강보험이 되는 치료는"
        },
        {
          "t": "실손 기본 보장에서 따로 계산해요."
        }
      ]
    },
    {
      "type": "image",
      "n": 1,
      "lines": [
        {
          "t": "정형외과 진료실에서 어깨를 살짝 만지며 궁금한 표정을 짓는 50대 어머니 (대표사진)"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "빨래를 널다가 팔이 위로 안 올라가서"
        },
        {
          "t": "\"아이고, 어깨야\" 하시는 엄마를 보면"
        },
        {
          "t": "괜히 마음이 쓰이는 날이 있어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "머리 감는 것도, 옷 입는 것도"
        },
        {
          "t": "힘들다고 하시면 더 그렇죠."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "결국 정형외과에 모시고 가면"
        },
        {
          "t": "오십견이라는 말을 듣는 경우가 많아요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "그다음엔 물리치료, 주사 치료, 도수치료처럼"
        },
        {
          "t": "여러 치료 이름이 한꺼번에 나와요."
        },
        {
          "t": "하나하나 비용이 다르다는 말에 더 막막해지죠."
        },
        {
          "t": "어떤 걸 먼저 받아야 하는지도 헷갈리고요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "그 순간 드는 생각은 하나예요."
        },
        {
          "t": "\"이거 다 받으면 병원비가 얼마지?"
        },
        {
          "t": "엄마 실비로 돌려받을 수는 있나?\""
        },
        {
          "t": "오늘은 그 질문에 치료별로 답해 볼게요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "어깨 통증 치료는 한두 번으로 끝나기보다"
        },
        {
          "t": "몇 달씩 이어지는 경우가 많아요."
        },
        {
          "t": "그래서 처음에 계산 방식을 알아 두면"
        },
        {
          "t": "영수증이 쌓여도 덜 헷갈려요."
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "오십견 실비, 치료마다 계산 칸이 달라요"
        }
      ]
    },
    {
      "type": "image",
      "n": 2,
      "lines": [
        {
          "t": "오십견 실비를 묻는 첫머리 카드"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "오십견 실비를 볼 때 가장 먼저 알아 둘 건"
        },
        {
          "t": "치료마다 영수증의 칸이 다르다는 점이에요."
        },
        {
          "t": "같은 날 받은 치료라도 어떤 건 급여,"
        },
        {
          "t": "어떤 건 비급여로 나뉘어 찍혀요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "급여 물리치료는 기본 보장에서,",
          "s": "yellow"
        },
        {
          "t": "비급여 치료는 비급여 특약에서 따로 봐요.",
          "s": "yellow"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "어깨 통증으로 받는 온열치료나 전기치료 같은"
        },
        {
          "t": "기본 물리치료는 대개 급여 칸에 찍혀요."
        },
        {
          "t": "반면 체외충격파나 일부 주사 치료는"
        },
        {
          "t": "비급여 칸에 찍히는 경우가 많아요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "그래서 오십견 실비는 \"된다, 안 된다\"보다"
        },
        {
          "t": "\"어느 칸으로 얼마나 돌아오나\"로 보는 게 정확해요."
        },
        {
          "t": "영수증 한 장을 칸별로 나눠 보면 답이 보여요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "진료비 세부내역서를 함께 받으면"
        },
        {
          "t": "항목마다 급여인지 비급여인지가 줄마다 적혀"
        },
        {
          "t": "엄마 영수증을 대신 보는 자녀도 이해하기 쉬워요."
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "어깨 통증 물리치료, 매일 다니면"
        }
      ]
    },
    {
      "type": "image",
      "n": 3,
      "lines": [
        {
          "t": "정형외과 물리치료실에서 어깨에 온열 패드를 대고 쉬는 50대 어머니"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "오십견은 몇 주에서 몇 달씩"
        },
        {
          "t": "꾸준히 병원에 다니며 치료받는 경우가 많아요."
        },
        {
          "t": "그래서 하루하루의 계산 방식을 알아 두면 좋아요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "실손은 하루에 병원을 여러 번 가도"
        },
        {
          "t": "통원 1회로 묶어서 계산해요."
        },
        {
          "t": "4세대 실손이라면 의원 통원은"
        },
        {
          "t": "1만 원과 20% 중 큰 금액을 빼요.",
          "segs": [
            {
              "t": "1만 원",
              "s": "blue"
            },
            {
              "t": "과 20% 중 큰 금액을 빼요."
            }
          ]
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "하루 물리치료비가 1만 원이 안 되면",
          "s": "yellow"
        },
        {
          "t": "4세대 오십견 실비는 남는 게 없을 수 있어요.",
          "s": "yellow"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "그렇다고 영수증을 버릴 필요는 없어요."
        },
        {
          "t": "주사 치료처럼 금액이 큰 날과 겹치면"
        },
        {
          "t": "그날 통원 1회 안에서 합쳐 계산되거든요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "예를 들어 같은 날 물리치료와 주사 치료를 받았다면"
        },
        {
          "t": "두 금액이 한 번의 통원으로 묶여요."
        },
        {
          "t": "어깨 통증으로 자주 다닌다면 날짜별로"
        },
        {
          "t": "영수증을 모아 두는 습관이 도움이 돼요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "3세대 이전 실손은 공제 방식이 또 달라요."
        },
        {
          "t": "가입한 해의 약관이 기준이라"
        },
        {
          "t": "엄마 증권의 가입 날짜를 먼저 봐야 해요."
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "주사 치료와 도수치료는 특약에서"
        }
      ]
    },
    {
      "type": "image",
      "n": 4,
      "lines": [
        {
          "t": "진료실 책상 위에 놓인 어깨 관절 모형과 빈 처방전"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "2017년 4월 뒤 가입한 실손은"
        },
        {
          "t": "비급여 주사를 따로 떼어 특약으로 뒀어요."
        },
        {
          "t": "한도는 연 250만 원·50회예요.",
          "segs": [
            {
              "t": "한도는 연 "
            },
            {
              "t": "250만 원",
              "s": "blue"
            },
            {
              "t": "·50회예요."
            }
          ]
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "도수치료와 체외충격파는 또 다른 특약으로 묶여"
        },
        {
          "t": "연 350만 원·50회 안에서 보고,"
        },
        {
          "t": "10회마다 효과가 확인돼야 이어서 보장해요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "주사 치료와 도수치료는 서로 다른 특약이라",
          "s": "yellow"
        },
        {
          "t": "한도도 따로따로 셈해요.",
          "s": "yellow"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "내 몫으로 빼는 금액도 세대마다 달라요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "3세대 특약은 2만 원과 30% 가운데 큰 쪽,"
        },
        {
          "t": "4세대는 비급여 30%에 통원이면 3만 원과"
        },
        {
          "t": "견줘서 큰 쪽을 빼는 구조예요."
        },
        {
          "t": "같은 금액이라도 엄마와 내 계산이 다를 수 있어요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "여기에 2026년 7월 1일부터 도수치료는",
          "segs": [
            {
              "t": "여기에 "
            },
            {
              "t": "2026년 7월 1일",
              "s": "blue"
            },
            {
              "t": "부터 도수치료는"
            }
          ]
        },
        {
          "t": "건강보험 관리급여가 됐어요."
        },
        {
          "t": "주 2회, 연 15회가 기본이고"
        },
        {
          "t": "기준을 넘겨 받으면 실손도 적용되지 않아요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "체외충격파도 보건복지부 가이드라인이 생겨"
        },
        {
          "t": "부위당 6회, 1년에 12회를 권장하고 있어요."
        },
        {
          "t": "어깨 한 곳이라면 6회가 먼저 보는 선이에요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "금융위원회 발표를 보면 5세대 실손은",
          "s": "red"
        },
        {
          "t": "도수치료와 비급여 주사제를 보장하지 않아요.",
          "s": "red"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "최근에 실손을 갈아타셨다면"
        },
        {
          "t": "이 부분을 꼭 같이 확인해 보세요."
        },
        {
          "t": "갈아타기 전 실손과 계산이 꽤 달라져요."
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "오십견 실비 청구 전 체크"
        }
      ]
    },
    {
      "type": "image",
      "n": 5,
      "lines": [
        {
          "t": "거실 소파에서 엄마의 보험 증권을 함께 넘겨 보는 30대 딸"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "청구하기 전에 아래 다섯 가지를 확인해요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "✔ 진단명에 어깨 질환이 적혀 있는지"
        },
        {
          "t": "✔ 영수증의 급여·비급여 칸을 나눠 봤는지"
        },
        {
          "t": "✔ 진료비 세부내역서를 받았는지"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "✔ 엄마 실손이 몇 세대인지"
        },
        {
          "t": "✔ 비급여 특약이 붙어 있는지"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "✔ 오십견 실비 한 줄 정리",
          "s": "green"
        },
        {
          "t": "급여 물리치료는 기본 보장, 주사 치료와 도수치료는",
          "s": "green"
        },
        {
          "t": "각자의 비급여 특약에서 한도를 따로 봐요",
          "s": "green"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "\"엄마 실손은 오래돼서 특약이 없을 텐데?\""
        },
        {
          "t": "이렇게 생각하시는 분도 많아요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "2017년 4월 전 실손은 특약 구분 없이"
        },
        {
          "t": "비급여를 함께 보는 구조라 약관을 먼저 펴 봐요."
        },
        {
          "t": "오래된 실손일수록 오히려 넓게 보는 항목이"
        },
        {
          "t": "있을 수 있으니 미리 단정하지 않는 게 좋아요."
        }
      ]
    },
    {
      "type": "quote",
      "lines": [
        {
          "t": "오십견 실비 정리"
        }
      ]
    },
    {
      "type": "image",
      "n": 6,
      "lines": [
        {
          "t": "공원에서 팔을 천천히 올리며 가볍게 스트레칭하는 50대 어머니와 딸"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "여러분 부모님도 어깨 때문에 고생하신 적 있으세요?"
        },
        {
          "t": "'있어요'나 '없어요'로 남겨 주세요."
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "오십견 실비는 영수증 칸을 나눠 보고,",
          "s": "yellow"
        },
        {
          "t": "특약마다 한도를 따로 세면 훨씬 쉬워져요.",
          "s": "yellow"
        }
      ]
    },
    {
      "type": "p",
      "lines": [
        {
          "t": "어떤 치료를 몇 번 받을지는"
        },
        {
          "t": "정형외과 전문의와 상의해서 정하는 게 먼저예요."
        },
        {
          "t": "청구는 상법상 3년 안에 하면 되니"
